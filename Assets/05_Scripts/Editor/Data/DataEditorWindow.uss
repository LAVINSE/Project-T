.project-data-root { flex-grow: 1; }
.project-data-body { flex-grow: 1; flex-direction: row; min-height: 0; }
.project-data-toolbar { flex-direction: row; flex-wrap: wrap; align-items: center; padding: 4px 8px; background-color: var(--sw-toolbar); border-bottom-width: 1px; border-bottom-color: var(--sw-border); }
.project-data-spacer { flex-grow: 1; }
.project-data-sidebar { width: 300px; flex-shrink: 0; background-color: var(--sw-sidebar); border-right-width: 1px; border-right-color: var(--sw-border); }
.project-data-search { flex-direction: row; align-items: center; padding: 6px; border-bottom-width: 1px; border-bottom-color: var(--sw-border); }
.project-data-search > .unity-base-field { flex-grow: 1; min-width: 0; margin-right: 4px; }
.project-data-search > .unity-button { font-size: 12px; padding: 2px 6px; }
.project-data-list { flex-grow: 1; min-height: 0; }
.project-data-list-row { height: 43px; flex-direction: row; align-items: center; padding: 5px 8px; border-bottom-width: 1px; border-bottom-color: var(--sw-border); border-left-width: 3px; border-left-color: transparent; }
.project-data-list-row:hover { background-color: var(--sw-hover); }
.project-data-list-row.project-data-selected { background-color: var(--sw-selection); border-left-color: var(--sw-accent); }
.project-data-asset-icon { width: 25px; height: 25px; flex-shrink: 0; margin-right: 10px; }
.project-data-asset-name { flex-grow: 1; min-width: 40px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.project-data-asset-type { max-width: 135px; margin-left: 8px; color: var(--sw-muted); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.project-data-count { padding: 6px 12px; color: var(--sw-muted); font-size: 12px; border-top-width: 1px; border-top-color: var(--sw-border); }
.project-data-detail { flex-grow: 1; min-width: 0; }
.project-data-detail-header { flex-direction: row; align-items: center; padding: 8px 12px; border-bottom-width: 1px; border-bottom-color: var(--sw-border); background-color: var(--sw-panel); }
.project-data-identity { flex-grow: 1; min-width: 0; margin-right: 8px; }
.project-data-asset-title { -unity-font-style: bold; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.project-data-asset-subtitle { color: var(--sw-muted); font-size: 11px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; margin-top: 3px; }
.project-data-detail-header > .unity-button { font-size: 12px; padding: 3px 8px; }
.project-data-scroll { flex-grow: 1; min-height: 0; }
.project-data-content { padding: 6px 12px 16px; }
.project-data-row { flex-direction: row; flex-wrap: wrap; align-items: center; }
.project-data-row > .unity-button { margin-right: 4px; }
.project-data-row > .unity-base-field { flex-grow: 1; }
.project-data-description { white-space: normal; color: var(--sw-muted); font-size: 12px; margin: 4px 0; }
.project-data-section { margin: 0 0 6px; padding: 0 0 6px; border-bottom-width: 1px; border-bottom-color: var(--sw-border); }
.project-data-section > .unity-foldout__toggle { -unity-font-style: bold; }
.project-data-root .project-data-content .unity-base-field { min-height: 28px; margin: 2px 0; }
.project-data-root .project-data-content .unity-base-field__label { min-width: 130px; max-width: 45%; font-size: 13px; white-space: normal; }
.project-data-root .project-data-content .unity-base-text-field__input,
.project-data-root .project-data-content .unity-popup-field__input,
.project-data-root .project-data-content .unity-enum-field__input,
.project-data-root .project-data-content .unity-object-field__input { min-height: 28px; padding-top: 2px; padding-bottom: 2px; font-size: 13px; }
.project-data-root .project-data-content .unity-foldout__toggle { min-height: 28px; margin: 2px 0; }
.project-data-root .project-data-content .unity-foldout__text { font-size: 13px; }
.project-data-content .unity-foldout { margin-left: 0; }
.project-data-section > .unity-foldout__content { margin-left: 8px; }
.project-data-field { min-width: 0; }
.project-data-menu { background-color: var(--sw-toolbar); color: var(--sw-text); border-width: 1px; border-color: var(--sw-border); border-radius: 4px; padding: 4px 8px; margin: 2px; min-height: 32px; }
.project-data-menu:hover { background-color: var(--sw-hover); border-color: var(--sw-accent); }
.project-data-array-row { margin: 2px 0 4px; padding: 2px 0 4px; border-bottom-width: 1px; border-bottom-color: var(--sw-border); }
.project-data-array-inline { flex-direction: row; align-items: flex-start; }
.project-data-array-inline > .project-data-field { flex-grow: 1; }
.project-data-array-controls { flex-direction: row; flex-shrink: 0; }
.project-data-root .project-data-array-controls > .unity-button { min-height: 26px; width: 26px; padding: 0; font-size: 13px; }
.project-data-array-header { flex-direction: row; align-items: center; }
.project-data-entry-title { flex-grow: 1; color: var(--sw-muted); font-size: 12px; }
.project-data-reference { padding-left: 8px; border-left-width: 2px; border-left-color: var(--sw-accent); }
.project-data-reference > .unity-button { margin-bottom: 4px; }
.project-data-status { white-space: normal; padding: 5px 12px; font-size: 12px; border-top-width: 1px; border-top-color: var(--sw-border); background-color: var(--sw-toolbar); }
.project-data-heading { white-space: normal; font-size: 14px; -unity-font-style: bold; margin: 6px 0; }
.project-data-primary.unity-button { background-color: var(--sw-accent); color: #1e2028; -unity-font-style: bold; }
.project-data-preview-image { height: 220px; margin: 10px 0; background-color: var(--sw-background); }
.project-data-route { height: 240px; margin: 10px 0; background-color: var(--sw-background); }
.project-data-route-order { width: 36px; flex-shrink: 0; -unity-text-align: middle-center; color: var(--sw-muted); }
.project-data-route-role { width: 48px; flex-shrink: 0; color: var(--sw-muted); }
.project-data-route-point { flex-grow: 1; min-width: 0; margin-right: 6px; }
.project-data-route-point .unity-base-field__label { display: none; }
.project-data-route-point .unity-base-field { margin: 0; }
.project-data-message.unity-button { white-space: normal; -unity-text-align: middle-left; padding: 8px; }
.project-data-compact.unity-button { min-width: 48px; }
.project-data-hidden { display: none; }
.project-data-list-options { padding: 4px 6px; }
.project-data-list-options .unity-base-field__label { min-width: 45px; }
.project-data-stat-table { border-width: 1px; border-color: var(--sw-border); border-radius: 4px; margin-top: 4px; }
.project-data-stat-row { flex-direction: row; align-items: center; min-height: 34px; padding: 2px 6px; border-bottom-width: 1px; border-bottom-color: var(--sw-border); }
.project-data-stat-row:hover { background-color: var(--sw-hover); }
.project-data-stat-header { background-color: var(--sw-panel); color: var(--sw-muted); font-size: 11px; }
.project-data-stat-use { width: 32px; flex-shrink: 0; }
.project-data-stat-name { flex-grow: 1; flex-basis: 72px; min-width: 48px; margin-right: 6px; white-space: normal; }
.project-data-stat-link { flex-grow: 1; flex-basis: 150px; min-width: 110px; margin-right: 6px; }
.project-data-stat-link .unity-base-field { margin: 0; }
.project-data-stat-link .unity-base-popup-field__input { min-height: 22px; }
.project-data-stat-tools { flex-direction: row; align-items: center; flex-shrink: 0; margin-left: 4px; }
.project-data-stat-tools .unity-button { width: 22px; min-width: 22px; height: 20px; margin: 0 1px; padding: 0; }
.project-data-stat-tools .project-data-array-controls { flex-direction: row; margin-left: 4px; }
.project-data-stat-shared { width: 62px; flex-shrink: 0; color: var(--sw-muted); white-space: normal; }
.project-data-stat-override { flex-direction: row; align-items: center; flex-grow: 1; flex-basis: 110px; min-width: 90px; margin-right: 8px; }
.project-data-stat-toggle { width: 22px; flex-shrink: 0; }
.project-data-stat-amount { flex-grow: 1; min-width: 0; }
.project-data-stat-result { width: 68px; flex-shrink: 0; white-space: normal; -unity-font-style: bold; }
.project-data-stat-excluded > .project-data-stat-name,
.project-data-stat-excluded > .project-data-stat-result { color: var(--sw-muted); }
.project-data-root .project-data-content .project-data-stat-row .unity-base-field { min-height: 24px; }
.project-data-root .project-data-content .project-data-stat-row .unity-base-text-field__input { min-height: 24px; }
